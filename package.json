{
    "name": "vendure-mpesa-plugin",
    "version": "0.0.23",
    "description": "Accept Mpesa payments on your Vendure store",
    "repository": {
        "type": "git",
        "url": "git@github.com:barakamwakisha/vendure-mpesa-plugin.git"
    },
    "author": "Baraka Mwakisha <barakamwakisha@gmail.com>",
    "license": "MIT",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist",
        "README.md"
    ],
    "scripts": {
        "clean": "rimraf tsconfig.lib.tsbuildinfo dist __admin-ui __data__ dev-server/vendure.sqlite",
        "transpile": "yarn clean && tsc -p tsconfig.lib.json",
        "build": "yarn transpile && copyfiles -u 1 'src/ui/**/*' dist",
        "test": "yarn clean && vitest run",
        "dev": "yarn clean && ts-node --transpile-only dev-server/index.ts",
        "prepare": "husky",
        "lint": "yarn lint:eslint && yarn lint:prettier",
        "lint:eslint": "eslint \"**/*.*\"",
        "lint:prettier": "prettier --check \"**/*.*\"",
        "prettier": "prettier --check \"**/*.*\"",
        "fix": "yarn fix:eslint && yarn fix:prettier",
        "fix:eslint": "eslint --fix \"**/*.*\"",
        "fix:prettier": "prettier --write \"**/*.*\"",
        "release": "yarn build && changeset publish"
    },
    "devDependencies": {
        "@changesets/cli": "^2.27.1",
        "@eslint/compat": "^1.4.0",
        "@eslint/eslintrc": "^3.3.1",
        "@eslint/js": "^9.37.0",
        "@swc/core": "1.13.5",
        "@types/node": "^24.7.2",
        "@typescript-eslint/eslint-plugin": "^6.21.0",
        "@typescript-eslint/parser": "^6.21.0",
        "@vendure/admin-ui-plugin": "^3.4.4",
        "@vendure/asset-server-plugin": "^3.4.4",
        "@vendure/core": "^3.4.4",
        "@vendure/testing": "^3.4.4",
        "@vendure/ui-devkit": "^3.4.4",
        "better-sqlite3": "^12.4.1",
        "copyfiles": "^2.4.1",
        "eslint": "^9.37.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.4",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-prettier": "^5.5.4",
        "gql.tada": "^1.8.13",
        "husky": "^9.1.7",
        "lint-staged": "^16.2.4",
        "nock": "^14.0.10",
        "prettier": "^3.6.2",
        "rimraf": "^5.0.5",
        "ts-node": "^10.9.2",
        "typescript": "5.8.3",
        "typescript-eslint": "^8.46.1",
        "unplugin-swc": "^1.5.7",
        "vite-tsconfig-paths": "^5.1.4",
        "vitest": "^3.2.4",
        "zod": "^3.22.4"
    },
    "dependencies": {
        "axios": "^1.6.7",
        "libphonenumber-js": "^1.10.54"
    },
    "engines": {
        "npm": "please-use-yarn",
        "yarn": ">= 1.19.1"
    },
    "lint-staged": {
        "**/*.*": [
            "yarn fix"
        ]
    },
    "packageManager": "yarn@4.6.0+sha512.5383cc12567a95f1d668fbe762dfe0075c595b4bfff433be478dbbe24e05251a8e8c3eb992a986667c1d53b6c3a9c85b8398c35a960587fbd9fa3a0915406728"
}
